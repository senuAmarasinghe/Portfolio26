# Public URL of the deployed site (used for metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: read-only GitHub token (fine-grained, "Public repositories" read-only).
# Raises the GitHub API limit from 60 to 5,000 requests/hour. Server-only: never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
